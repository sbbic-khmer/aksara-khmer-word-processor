# Aksara Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE (Railway PostgreSQL)
# =============================================================================
# Public URL - used for local development, migrations, Prisma Studio
DATABASE_URL=postgresql://user:password@host.railway.app:5432/railway

# Internal URL - used by app in Railway for production runtime (lower latency, no egress costs)
# Only set this in Railway environment; leave blank for local development
INTERNAL_DATABASE_URL=postgresql://user:password@postgres.railway.internal:5432/railway

# =============================================================================
# AUTHENTICATION (Better Auth)
# =============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_generated_secret_here

# Your app's public URL (Railway provides this)
BETTER_AUTH_URL=https://your-app.up.railway.app
NEXT_PUBLIC_BETTER_AUTH_URL=https://your-app.up.railway.app

# =============================================================================
# CLOUDFLARE TURNSTILE (Bot Protection)
# =============================================================================
# Get keys from: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# =============================================================================
# ELEVENLABS (Voice Input)
# =============================================================================
# Get key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# =============================================================================
# ADVERTISING (ExoClick)
# =============================================================================
# Ad zone IDs are configured in the components/ads/ directory
# No environment variables needed - ads are controlled via /api/ads/config

# =============================================================================
# DOCUMENT ENCRYPTION (Optional - Documents stored in plaintext if not set)
# =============================================================================
# Generate with: openssl rand -base64 32
# IMPORTANT: Back up this key securely! Lost key = unrecoverable documents
# Leave unset for development to store documents in plaintext
ENCRYPTION_KEY=

# =============================================================================
# EMAIL (SMTP - Purelymail)
# =============================================================================
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Aksara Pro

# =============================================================================
# CRON (Email Queue Processing)
# =============================================================================
# Secret for authenticating cron requests
# Generate with: openssl rand -base64 32
CRON_SECRET=your_cron_secret_here

# For the cron service only (set in the cron-service Railway service):
# Use internal URL for faster requests and no egress costs
# CRON_TARGET_URL=http://aksara.railway.internal

# =============================================================================
# FEATURE FLAGS
# =============================================================================
SIGNUPS_ENABLED=true
NEXT_PUBLIC_SIGNUPS_ENABLED=true
NEXT_PUBLIC_SHOW_SAMPLE_TEXT=true

# =============================================================================
# DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION)
# =============================================================================
# ALLOW_DEV_AUTH_BYPASS=true  # NEVER enable in production!
