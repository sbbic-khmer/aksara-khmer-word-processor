# Aksara Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# =============================================================================
# AUTHENTICATION
# =============================================================================
# HTTP Basic Auth for protected routes (optional)
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_secure_password

# =============================================================================
# CLOUDFLARE TURNSTILE (Bot Protection)
# =============================================================================
# Get keys from: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# =============================================================================
# ELEVENLABS (Voice Input)
# =============================================================================
# Get key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# =============================================================================
# GOOGLE ADSENSE (Advertising - Optional)
# =============================================================================
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=xxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SIDEBAR_LEFT_SLOT=xxxxxxxxxx
NEXT_PUBLIC_ADSENSE_MOBILE_SLOT=xxxxxxxxxx

# =============================================================================
# FEATURE FLAGS
# =============================================================================
SIGNUPS_ENABLED=true
NEXT_PUBLIC_SIGNUPS_ENABLED=true
NEXT_PUBLIC_SHOW_SAMPLE_TEXT=true

# =============================================================================
# DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION)
# =============================================================================
# ALLOW_DEV_AUTH_BYPASS=true  # NEVER enable in production!
