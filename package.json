{
  "name": "aksara",
  "version": "1.0.0",
  "description": "Khmer text editor with automatic word breaking, spell checking, and document management",
  "keywords": [
    "tiptap",
    "khmer",
    "text-breaking",
    "word-break",
    "line-break",
    "unicode",
    "icu"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "khmer-tiptap-extension.js",
  "files": [
    "khmer-breaker.js",
    "khmer-tiptap-extension.js",
    "dictionary-converter.js",
    "README.md"
  ],
  "scripts": {
    "build": "prisma generate && next build",
    "convert-dict": "node convert-dictionary.js",
    "demo": "npx serve .",
    "dev": "prisma generate && next dev -p 3001",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
